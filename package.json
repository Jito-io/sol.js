{
  "name": "sol.js",
  "version": "0.1.0",
  "type": "module",
  "description": "The ethers.js of the Solana protocol",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.0.0"
  },
  "author": "Dr. Q and Company",
  "license": "MIT"
}
